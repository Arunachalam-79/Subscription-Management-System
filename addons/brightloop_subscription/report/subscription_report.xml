<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_subscription" model="ir.actions.report">
        <field name="name">Subscription Quotation</field>
        <field name="model">brightloop.subscription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">brightloop_subscription.report_subscription_document</field>
        <field name="report_file">brightloop_subscription.report_subscription_document</field>
        <field name="print_report_name">'Subscription - %s' % (object.name or 'Draft')</field>
        <field name="binding_model_id" ref="model_brightloop_subscription"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_subscription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Subscription <span t-field="o.name"/></h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Customer</strong>
                                <div t-field="o.partner_id"
                                     t-options='{"widget": "contact", "fields": ["name", "address", "phone", "email"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <div><strong>Plan:</strong> <span t-field="o.plan_id.name"/>
                                    (<span t-field="o.plan_id.billing_period"/>)</div>
                                <div><strong>Start date:</strong> <span t-field="o.start_date"/></div>
                                <div t-if="o.expiry_date"><strong>Expires:</strong> <span t-field="o.expiry_date"/></div>
                                <div t-if="o.user_id"><strong>Salesperson:</strong> <span t-field="o.user_id.name"/></div>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Disc. %</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.discount"/></td>
                                    <td class="text-end"><span t-field="line.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row justify-content-end">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Untaxed</td>
                                        <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                                    </tr>
                                    <tr>
                                        <td>Taxes</td>
                                        <td class="text-end"><span t-field="o.amount_tax"/></td>
                                    </tr>
                                    <tr class="border-black fw-bold">
                                        <td>Total per <span t-field="o.plan_id.billing_period"/> period</td>
                                        <td class="text-end"><span t-field="o.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div t-if="o.note" class="mt-4"><span t-field="o.note"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
