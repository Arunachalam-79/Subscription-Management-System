<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_tree" model="ir.ui.view">
        <field name="name">brightloop.discount.tree</field>
        <field name="model">brightloop.discount</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="discount_type"/>
                <field name="value"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="usage_count"/>
                <field name="usage_limit"/>
            </tree>
        </field>
    </record>
    <record id="view_discount_form" model="ir.ui.view">
        <field name="name">brightloop.discount.form</field>
        <field name="model">brightloop.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="discount_type"/>
                            <field name="value"/>
                            <field name="apply_to"/>
                            <field name="product_ids" widget="many2many_tags"
                                   invisible="apply_to != 'product'"/>
                        </group>
                        <group>
                            <field name="min_purchase"/>
                            <field name="min_quantity"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="usage_limit"/>
                            <field name="usage_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_discount" model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">brightloop.discount</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
