<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qt_form" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.form</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="plan_id"/>
                        <field name="validity_days"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qt_tree" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.tree</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
            </tree>
        </field>
    </record>
    <record id="action_qt" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">brightloop.quotation.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
