<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_brightloop" model="ir.module.category">
        <field name="name">Brightloop Subscriptions</field>
    </record>

    <record id="group_brightloop_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_brightloop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_brightloop_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_brightloop"/>
        <field name="implied_ids" eval="[(4, ref('group_brightloop_staff'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Customers (portal users) only see their own subscriptions -->
    <record id="rule_subscription_portal" model="ir.rule">
        <field name="name">Portal: own subscriptions</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
    </record>
</odoo>
